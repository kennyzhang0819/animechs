{
  "name": "mechswarm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "dev:web": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen:tiles": "node --experimental-strip-types scripts/gen-tiles.mjs",
    "playtest": "node scripts/playtest.mjs",
    "build:static": "bash scripts/build-static.sh",
    "desktop": "npm run build:static && npm --prefix desktop run start",
    "desktop:pack": "npm run build:static && npm --prefix desktop run pack",
    "desktop:pack:steam": "npm run build:static && npm --prefix desktop run pack:steam",
    "desktop:test": "npm --prefix desktop test"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
