{
  "name": "animechs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:art": "node scripts/sync-foundry-art.mjs",
    "predev": "npm run sync:art",
    "predev:web": "npm run sync:art",
    "predev:hot": "npm run sync:art",
    "prebuild": "npm run sync:art",
    "dev": "node scripts/desktop-dev.mjs",
    "dev:web": "node scripts/desktop-dev.mjs --no-shell",
    "build": "next build",
    "start": "next start",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "bench": "node scripts/bench.mjs",
    "typecheck": "tsc --noEmit",
    "gen:tiles": "node --experimental-transform-types --import ./scripts/ts-hooks.mjs scripts/gen-tiles.mjs",
    "gen:turrets": "node --experimental-transform-types --import ./scripts/ts-hooks.mjs scripts/turret-concepts.mjs",
    "gen:terrain": "node --experimental-transform-types --import ./scripts/ts-hooks.mjs scripts/terrain-concepts.mjs",
    "gen:air": "node --experimental-transform-types --import ./scripts/ts-hooks.mjs scripts/air-concepts.mjs",
    "playtest": "node scripts/playtest.mjs",
    "build:static": "bash scripts/build-static.sh",
    "desktop": "npm run build:static && npm --prefix desktop run start",
    "desktop:pack": "npm run build:static && npm --prefix desktop run pack",
    "desktop:pack:steam": "npm run build:static && npm --prefix desktop run pack:steam",
    "desktop:test": "npm --prefix desktop test",
    "dev:hot": "next dev --turbopack"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
